# Runtime
NODE_ENV=development
PORT=3000

# Security
JWT_SECRET=replace-with-strong-random-secret

# CORS
CORS_ORIGIN=
CORS_EXTRA_ORIGINS=

# AI
GEMINI_API_KEY=
APP_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=BananaLeaf <orders@bananaleaf.com>

# Supabase project metadata
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Primary database connection (recommended: Supabase transaction pooler)
# Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional explicit SSL mode override (default behavior is automatic)
# Allowed values: require, disable
DATABASE_SSL=require

# Payments (placeholders for production integration)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional seeding control
FORCE_RESEED=false
