# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# SUPABASE_URL: Public Supabase project URL.
SUPABASE_URL=

# SUPABASE_ANON_KEY: Public anon key for client-side Supabase integrations.
SUPABASE_ANON_KEY=

# JWT_SECRET: Required in production for signing auth tokens.
# Generate a high-entropy secret (at least 32 chars).
JWT_SECRET=

# NODE_ENV: Set to production on your host.
NODE_ENV=development

# PORT: HTTP port for the Express server.
PORT=3000

# CORS_ORIGIN: Optional allowed origin for browser API requests.
# Example: https://yourdomain.com
CORS_ORIGIN=

# DATABASE_URL: Supabase/PostgreSQL connection string.
# Example direct connection: postgres://postgres:password@db.<project-ref>.supabase.co:5432/postgres
# Example local override in .env.local: postgres://bananaleaf:bananaleaf@127.0.0.1:54329/bananaleaf
DATABASE_URL=

# DATABASE_SSL: Optional explicit SSL mode override.
# Supported values: require, disable
DATABASE_SSL=
