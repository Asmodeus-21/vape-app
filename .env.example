# Example environment variables for local development and deployment
# COPY THIS FILE to `.env` (local) and fill in your real secrets.
# DO NOT commit real secret keys to the repository.

# Server-side secret key (required for creating PaymentIntents)
STRIPE_SECRET_KEY=

# Client-side publishable key (used by Stripe.js)
# Depending on your build, you may expose this as VITE_STRIPE_PUBLISHABLE_KEY
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Email configuration for order confirmations and OTPs
# GoDaddy SMTP (recommended):
#   - SMTP_HOST: smtpout.secureserver.net (or check your GoDaddy control panel)
#   - SMTP_PORT: 587 (STARTTLS, not SSL)
#   - SMTP_SECURE: false (STARTTLS)
#   - SMTP_PASS: Use app-specific password from GoDaddy Security settings, not your account password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BananaLeaf <orders@bananaleaf.com>
RESEND_API_KEY=

# Standard app secrets
JWT_SECRET=
DATABASE_URL=
CORS_ORIGIN=

# Notes:
# - Locally create a `.env` with the real values and restart the server.
# - On Vercel set the same variables in the Project > Settings > Environment Variables.
# - Only `STRIPE_PUBLISHABLE_KEY` (the pk_... key) should be exposed to the browser.# Runtime
NODE_ENV=development
PORT=3000

# Security
JWT_SECRET=replace-with-strong-random-secret

# CORS
CORS_ORIGIN=
CORS_EXTRA_ORIGINS=

# AI
GEMINI_API_KEY=
APP_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=BananaLeaf <orders@bananaleaf.com>

# Supabase project metadata
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Primary database connection (recommended: Supabase transaction pooler)
# Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional explicit SSL mode override (default behavior is automatic)
# Allowed values: require, disable
DATABASE_SSL=require

# Payments (placeholders for production integration)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional seeding control
FORCE_RESEED=false
