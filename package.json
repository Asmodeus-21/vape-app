{
    "name": "banana-leaf-store",
    "private": true,
    "version": "1.0.0",
    "description": "Production-ready vape and nicotine commerce platform with OTP auth, JuiceFly-style UX, and guest checkout.",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "start": "tsx server.ts",
        "db:migrate:supabase": "tsx db/migrate-postgres.ts",
        "db:init:postgres": "tsx db/seed-postgres.ts",
        "db:seed:supabase": "tsx db/seed-postgres.ts",
        "db:seed": "set FORCE_RESEED=true && tsx db/seed-postgres.ts",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf dist",
        "lint": "tsc --noEmit",
        "verify": "npm run lint && npm run build"
    },
    "dependencies": {
        "@google/genai": "^1.29.0",
        "@stripe/react-stripe-js": "^6.3.0",
        "@stripe/stripe-js": "^9.5.0",
        "@supabase/supabase-js": "^2.105.4",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.2",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "nodemailer": "^8.0.8",
        "postgres": "^3.4.8",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.6.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.14.0",
        "resend": "^6.9.4",
        "stripe": "^22.1.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.14",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.14.0",
        "@types/nodemailer": "^8.0.0",
        "@vitejs/plugin-react": "^5.0.4",
        "autoprefixer": "^10.4.21",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    }
}
