{
    "name": "react-example",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "start": "npm run dev",
        "seed": "node --experimental-modules -e \"import { seed } from './db/seed.js'; seed();\"",
        "build": "vite build",
        "preview": "vite preview",
        "clean": "rm -rf dist",
        "lint": "tsc --noEmit",
        "qa:sitemap": "node generate-sitemap.cjs",
        "qa:performance": "node performance-audit.cjs",
        "qa:uptime": "node uptime-monitor.cjs --once",
        "qa:uptime:monitor": "node uptime-monitor.cjs",
        "qa:smoke": "node smoke-test.cjs",
        "qa:all": "npm run qa:sitemap && npm run qa:performance && npm run qa:smoke",
        "qa:ci": "npm run build && npm run qa:all"
    },
    "dependencies": {
        "@google/genai": "^1.29.0",
        "@tailwindcss/vite": "^4.1.14",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@vitejs/plugin-react": "^5.0.4",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.4.1",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.6.0",
        "react-markdown": "^10.1.0",
        "vite": "^6.2.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.14.0",
        "autoprefixer": "^10.4.21",
        "lighthouse": "^12.2.0",
        "puppeteer": "^23.6.0",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    }
}